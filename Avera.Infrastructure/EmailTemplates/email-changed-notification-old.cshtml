@*
  AVERA — User Changed Email (notice to old address)
  ================================================
  Trigger: fires AFTER an email change is fully confirmed and applied.
  This is the past-tense, "it's done" version — different from
  change-email-security-alert.cshtml, which fires BEFORE the change, at
  the moment it's first requested. This inbox is now disconnected from
  the account, so this is the last notice it will receive about it.

  Model properties expected:
    Model.Header       - cid for Email_Header.png
    Model.FirstName    - recipient's first name
    Model.OldEmail     - the address this email was sent to (now removed)
    Model.NewEmail     - the address now on file
    Model.ChangeDate   - e.g. "August 6, 2026"
    Model.ChangeTime   - e.g. "2:41 PM (GMT+8)"
    Model.SupportEmail - e.g. "support@avera.app"
    Model.CurrentYear  - e.g. "2026"
*@
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Your Avera Account Email Was Changed</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
  <style> @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap'); </style>
</head>
<body style="margin:0; padding:0; background-color:#F1F4F9; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
    Your Avera account email was changed to @Model.NewEmail on @Model.ChangeDate.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F4F9;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#FFFFFF; border-radius:12px; overflow:hidden; border:1px solid #E2E8F0;">

          <tr>
            <td style="padding:0;">
              <a href="#" style="cursor: text !important; pointer-events: none;">
                <img src="cid:@Model.Header" alt="Avera" width="600" style="display:block; width:100%; max-width:600px; height:auto; border:0;" />
              </a>
            </td>
          </tr>

          <tr>
            <td style="padding:40px 40px 24px 40px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <h1 style="margin:0 0 16px 0; font-size:22px; line-height:28px; font-weight:700; color:#0F172A;">
                Account Email Changed
              </h1>
              <p style="margin:0 0 8px 0; font-size:15px; line-height:22px; color:#0F172A;">
                Hi @Model.FirstName,
              </p>
              <p style="margin:0; font-size:15px; line-height:22px; color:#0F172A;">
                This confirms the email address on your Avera account was changed
                from <strong>@Model.OldEmail</strong> to <strong>@Model.NewEmail</strong>.
                This inbox will no longer receive account notifications.
              </p>
            </td>
          </tr>

          <!-- Change details -->
          <tr>
            <td style="padding:0 40px 8px 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F4F9; border:1px solid #E2E8F0; border-radius:10px;">
                <tr>
                  <td style="padding:16px 20px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#667085; border-bottom:1px solid #E2E8F0;">
                    Date
                  </td>
                  <td style="padding:16px 20px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#0F172A; text-align:right; border-bottom:1px solid #E2E8F0;">
                    @Model.ChangeDate
                  </td>
                </tr>
                <tr>
                  <td style="padding:16px 20px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#667085;">
                    Time
                  </td>
                  <td style="padding:16px 20px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#0F172A; text-align:right;">
                    @Model.ChangeTime
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security notice — plain text, no fill color -->
          <tr>
            <td style="padding:24px 40px 8px 40px; border-top:1px solid #E2E8F0; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <p style="margin:0; font-size:13px; line-height:20px; color:#667085;">
                <strong style="color:#0F172A;">Wasn't you?</strong> If you didn't make this
                change, contact us immediately at
                <a href="mailto:@Model.SupportEmail" style="color:#1E6FD9; text-decoration:none;">@Model.SupportEmail</a>.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:32px 40px 32px 40px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <p style="margin:0 0 4px 0; font-size:13px; line-height:19px; color:#667085; text-align:center;">
                Avera — Forensic Signature Verification
              </p>
              <p style="margin:0; font-size:12px; line-height:18px; color:#98A2B3; text-align:center;">
                &copy; @Model.CurrentYear Avera. This is an automated message, please don't reply directly to this email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
