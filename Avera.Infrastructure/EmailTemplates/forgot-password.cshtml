<!--
  AVERA — Forgot Password (reset code request)
  ================================================
  Trigger: User taps "Forgot Password" in the app and submits their email.

  Required template variables:
    @* @Model.Header  - hosted URL for Email_Header.png (see README) 
    @Model.FirstName        - recipient's first name
    @Model.Email          - the account email this code was sent to
    @Model.Code          - 6-digit numeric code, e.g. "482913"
    @Model.ExpiryMinutes      - e.g. "10"
    @Model.SupportEmail       - e.g. "support@avera.app"
    @Model.CurrentYear        - e.g. "2026"*@

  Color palette used (see README for full confidence notes):
    Primary blue   #1E6FD9  <- sampled directly from your app buttons, high confidence
    Text primary   #0F172A  <- sampled from screenshots
    Text secondary #667085  <- CONFIRM against colors.textSecondary, not visible in refs
    Border         #E2E8F0  <- CONFIRM against colors.border, approximated
    Page wrapper   #F1F4F9  <- CONFIRM against colors.background2, not visible in refs
-->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>Reset Your Avera Password</title>
  <!-- Sora web font. Renders in Gmail, Apple Mail, iOS/Android Mail.
       Outlook desktop (Windows) ignores this and silently falls back
       to Segoe UI in the stack below — no broken layout either way. -->
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap');
  </style>
  <!--[if mso]>
  <style type="text/css">
    table { border-collapse: collapse; }
    .fallback-font { font-family: Arial, sans-serif !important; }
  </style>
  <![endif]-->
</head>
<body style="margin:0; padding:0; background-color:#F1F4F9; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
  <!-- Preheader (hidden preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
    Use this code to reset your Avera password. It expires in @Model.ExpiryMinutes minutes.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F1F4F9;">
    <tr>
      <td align="center" style="padding:32px 16px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background-color:#FFFFFF; border-radius:12px; overflow:hidden; border:1px solid #E2E8F0; <!-- CONFIRM: colors.border -->">

          <!-- Header banner -->
          <tr>
            <td style="padding:0;">
              <a href="#" style="cursor: text !important; pointer-events: none;">
                <img src="@Model.Header" alt="Avera" width="600" style="display:block; width:100%; max-width:600px; height:auto; border:0;" />
              </a>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:40px 40px 24px 40px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <h1 style="margin:0 0 16px 0; font-size:22px; line-height:28px; font-weight:700; color:#0F172A;">
                Reset Your Password
              </h1>
              <p style="margin:0 0 8px 0; font-size:15px; line-height:22px; color:#0F172A;">
                Hi @Model.FirstName,
              </p>
              <p style="margin:0 0 24px 0; font-size:15px; line-height:22px; color:#0F172A;">
                We received a request to reset the password for your Avera account
                (<strong>@Model.Email</strong>). Enter the code below in the app to continue.
              </p>
            </td>
          </tr>

          <!-- Code block -->
          <tr>
            <td style="padding:0 40px 8px 40px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="background-color:#F1F4F9; border:1px solid #E2E8F0; border-radius:10px; padding:24px;">
                    <p style="margin:0 0 10px 0; font-size:12px; letter-spacing:0.06em; text-transform:uppercase; color:#667085; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                      Your reset code
                    </p>
                    <p style="margin:0; font-size:36px; line-height:1; font-weight:700; letter-spacing:0.35em; color:#1E6FD9; font-family:'Courier New', monospace;">
                      @Model.Code
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:16px 40px 8px 40px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <p style="margin:0; font-size:13px; line-height:20px; color:#667085; text-align:center;">
                This code will expire in <strong>@Model.ExpiryMinutes minutes</strong>.
              </p>
            </td>
          </tr>

          <!-- Security notice — plain text, no fill color, just a top divider -->
          <tr>
            <td style="padding:24px 40px 8px 40px; border-top:1px solid #E2E8F0; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <p style="margin:0; font-size:13px; line-height:20px; color:#667085;">
                <strong style="color:#0F172A;">Didn't request this?</strong> You can safely ignore this
                email — your password won't change unless this code is entered in the app.
                If you're concerned about your account's security, contact your organization admin
                or reach us at
                <a href="mailto:@Model.SupportEmail" style="color:#1E6FD9; text-decoration:none;">@Model.SupportEmail</a>.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:32px 40px 32px 40px; font-family:'Sora','Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
              <p style="margin:0 0 4px 0; font-size:13px; line-height:19px; color:#667085; text-align:center;">
                Avera — Forensic Signature Verification
              </p>
              <p style="margin:0; font-size:12px; line-height:18px; color:#98A2B3; text-align:center;">
                &copy; @Model.CurrentYear Avera. This is an automated message, please don't reply directly to this email.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
